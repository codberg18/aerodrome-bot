<Application x:Class="AerodromeSniper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AerodromeSniper.ViewModels"
             xmlns:views="clr-namespace:AerodromeSniper.Views"
             xmlns:conv="clr-namespace:AerodromeSniper.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <conv:PnlBrushConverter x:Key="PnlBrush" />
        <conv:PnlFormatConverter x:Key="PnlFormat" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullVisibilityConverter x:Key="NullToCollapsed" />
        <conv:NullVisibilityConverter x:Key="NullToVisible" Invert="True" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SniperViewModel}">
            <views:SniperView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CopyViewModel}">
            <views:CopyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PortfolioViewModel}">
            <views:PortfolioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Application.Resources>
</Application>
