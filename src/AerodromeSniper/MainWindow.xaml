<Window x:Class="AerodromeSniper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aerodrome Sniper"
        Width="1440" Height="900" MinWidth="1240" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource InterFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>
    <Border x:Name="RootBorder" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,0">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{StaticResource LogoGradientBrush}">
                        <TextBlock Text="A" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Aerodrome" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="SNIPER" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1" Margin="0,24,0,0" Style="{StaticResource NavList}"
                         ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Network status -->
                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource ProfitBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Base network" FontSize="12.5" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Block" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BlockHeight}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gas" FontSize="11" Margin="0,5,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GasPrice}" FontSize="11"
                                       Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Caption buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize">
                    <Path Data="M6,12 H18" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnToggleMaximize" ToolTip="Maximize">
                    <Path Data="M7,7 H17 V17 H7 Z" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClick" ToolTip="Close">
                    <Path Data="{StaticResource IconX}" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" />
                </Button>
            </StackPanel>

            <!-- Top bar -->
            <Grid Grid.Row="1" Margin="28,4,28,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ETH" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EthPriceUsd}" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EthChangePct}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfitBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" VerticalAlignment="Bottom" BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1" />

            <!-- Page -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>
    </Grid>
    </Border>
</Window>
