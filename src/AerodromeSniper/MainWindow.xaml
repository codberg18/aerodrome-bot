<Window x:Class="AerodromeSniper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aerodrome Sniper"
        Width="1440" Height="900" MinWidth="1240" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#090E1F" FontSize="13" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1022" BorderBrush="#1B2039" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,0">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#2660F5">
                        <TextBlock Text="A" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Aerodrome" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="SNIPER" FontSize="9.5" FontWeight="SemiBold" Foreground="#959CBF"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" Margin="0,24,0,0" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,8">
                                <Path Data="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#959CBF" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Background="#11162B" CornerRadius="12" BorderBrush="#1B2039"
                        BorderThickness="1" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center" />
                            <TextBlock Text="Base network" FontSize="12.5" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Block" FontSize="11" Foreground="#959CBF" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BlockHeight}" FontSize="11"
                                       Foreground="#959CBF" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gas" FontSize="11" Margin="0,5,0,0"
                                       Foreground="#959CBF" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GasPrice}" FontSize="11"
                                       Margin="0,5,0,0" Foreground="#959CBF" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,20,28,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPage.Title}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentPage.Subtitle}" FontSize="12" Foreground="#959CBF"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="999" Background="#161B32"
                        BorderBrush="#252B48" BorderThickness="1" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ETH" FontSize="12" FontWeight="SemiBold" Foreground="#959CBF"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EthPriceUsd}" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EthChangePct}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#4ADE80" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" BorderBrush="#1B2039" BorderThickness="0,0,0,1" />

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
