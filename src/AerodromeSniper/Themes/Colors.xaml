<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: aerodrome.finance dark theme v5 -->
    <Color x:Key="BackgroundColor">#090E1F</Color>
    <Color x:Key="SurfaceColor">#11162B</Color>
    <Color x:Key="SurfaceRaisedColor">#161B32</Color>
    <Color x:Key="SurfaceHoverColor">#1B2039</Color>
    <Color x:Key="BorderColor">#252B48</Color>
    <Color x:Key="BorderSubtleColor">#1B2039</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextMutedColor">#959CBF</Color>
    <Color x:Key="TextFaintColor">#444B6C</Color>
    <Color x:Key="PrimaryColor">#2660F5</Color>
    <Color x:Key="PrimaryHoverColor">#3D74F7</Color>
    <Color x:Key="PrimaryPressedColor">#1E4FD1</Color>
    <Color x:Key="AccentVioletColor">#615CF6</Color>
    <Color x:Key="ProfitColor">#4ADE80</Color>
    <Color x:Key="LossColor">#EF4444</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentVioletColor}" />
    <SolidColorBrush x:Key="ProfitBrush" Color="{StaticResource ProfitColor}" />
    <SolidColorBrush x:Key="LossBrush" Color="{StaticResource LossColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- Tinted backgrounds for badges / pills (alpha over surface) -->
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1F2660F5" />
    <SolidColorBrush x:Key="ProfitSoftBrush" Color="#1F4ADE80" />
    <SolidColorBrush x:Key="LossSoftBrush" Color="#1FEF4444" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1FF59E0B" />
    <SolidColorBrush x:Key="VioletSoftBrush" Color="#1F615CF6" />

    <SolidColorBrush x:Key="SidebarBrush" Color="#0B1022" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0C1122" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#252B48" />

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2660F5" Offset="0" />
        <GradientStop Color="#615CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3D74F7" Offset="0" />
        <GradientStop Color="#615CF6" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="InterFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>

</ResourceDictionary>
