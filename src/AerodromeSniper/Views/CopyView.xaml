<UserControl x:Class="AerodromeSniper.Views.CopyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AerodromeSniper.Models">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type models:WalletRow}">
            <Border Style="{StaticResource CardHover}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="{Binding Accent}">
                            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Address}" FontSize="11" FontFamily="Consolas"
                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                Command="{Binding DataContext.RemoveWalletCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="Stop copying and remove">
                            <Path Data="{StaticResource IconTrash}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}" Background="{StaticResource SurfaceRaisedBrush}">
                                <TextBlock Text="{Binding CopyModeText}" Style="{StaticResource BadgeText}"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                            <TextBlock Text="{Binding StatsText}" FontSize="11" Margin="10,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PnlText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding PnlPct, Converter={StaticResource PnlBrush}}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Watchlist -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="WATCHLIST" Style="{StaticResource CardLabel}" VerticalAlignment="Center" />
                <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0"
                        HorizontalAlignment="Right" Click="OnAddWallet">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Add wallet" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0"
                          Visibility="{Binding HasWallets, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Wallets}" />
            </ScrollViewer>

            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Center"
                    Visibility="{Binding HasWallets, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,16">
                    <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource IconUsers}" />
                    <TextBlock Text="No wallets yet" Style="{StaticResource EmptyTitle}" />
                    <TextBlock Style="{StaticResource EmptyHint}" MaxWidth="280" TextAlignment="Center"
                               Text="Add a wallet address and Aerodrome Sniper will mirror its swaps on this account." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Copy feed -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,4,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="COPY FEED" Style="{StaticResource CardLabel}" Margin="12,12,0,8" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Feed}" RowHeight="52">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME" Width="96" Binding="{Binding TimeText}" />
                        <DataGridTextColumn Header="WALLET" Width="110" Binding="{Binding WalletLabel}" />
                        <DataGridTextColumn Header="THEIR TRADE" Width="*" Binding="{Binding TheirText}" />
                        <DataGridTextColumn Header="OUR MIRROR" Width="130" Binding="{Binding OurText}" />
                        <DataGridTemplateColumn Header="STATUS" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Background="{Binding StatusBackground}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BadgeText}"
                                                   Foreground="{Binding StatusBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
