<UserControl x:Class="AerodromeSniper.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AerodromeSniper.Models"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type models:PositionRow}">
            <Grid Margin="0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="{Binding Accent}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Symbol}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding QuantityText}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ValueUsd}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding PnlPct, Converter={StaticResource PnlFormat}}" FontSize="11"
                               FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"
                               Foreground="{Binding PnlPct, Converter={StaticResource PnlBrush}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:ActivityRow}">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding KindBrush}"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Kind}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11"
                           Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Stat cards -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="TOTAL VALUE" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding TotalValueUsd}" Style="{StaticResource StatValue}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding TotalValueChange}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource ProfitBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="TOTAL P&amp;L" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding TotalPnlUsd}" Style="{StaticResource StatValue}" Margin="0,12,0,0"
                               Foreground="{Binding TotalPnlPct, Converter={StaticResource PnlBrush}}" />
                    <TextBlock Text="{Binding TotalPnlPct, Converter={StaticResource PnlFormat}}" FontSize="12"
                               FontWeight="SemiBold" Margin="0,6,0,0"
                               Foreground="{Binding TotalPnlPct, Converter={StaticResource PnlBrush}}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="24H P&amp;L" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding DayPnlUsd}" Style="{StaticResource StatValue}" Margin="0,12,0,0"
                               Foreground="{Binding DayPnlPct, Converter={StaticResource PnlBrush}}" />
                    <TextBlock Text="{Binding DayPnlPct, Converter={StaticResource PnlFormat}}" FontSize="12"
                               FontWeight="SemiBold" Margin="0,6,0,0"
                               Foreground="{Binding DayPnlPct, Converter={StaticResource PnlBrush}}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="OPEN POSITIONS" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding OpenPositionsCount}" Style="{StaticResource StatValue}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding OpenPositionsHint}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Chart + positions / activity -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="EQUITY" Style="{StaticResource CardLabel}" />
                        <lvc:CartesianChart Grid.Row="1" Margin="0,14,0,0"
                                            Series="{Binding EquitySeries}"
                                            XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            TooltipPosition="Hidden" ZoomMode="None" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="OPEN POSITIONS" Style="{StaticResource CardLabel}" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Positions}" Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ACTIVITY" Style="{StaticResource CardLabel}" />
                    <ScrollViewer Grid.Row="1" Margin="0,8,-8,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Activity}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
