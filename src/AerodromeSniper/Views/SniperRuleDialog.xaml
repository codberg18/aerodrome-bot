<Window x:Class="AerodromeSniper.Views.SniperRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New auto-snipe rule" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource InterFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}" UseLayoutRounding="True">
    <StackPanel Margin="24">
        <TextBlock Text="RULE NAME" Style="{StaticResource CardLabel}" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Style="{StaticResource TextInput}" Text="My rule" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="MIN LIQUIDITY" Style="{StaticResource CardLabel}" Margin="0,0,0,8" />
                <ComboBox x:Name="LiquidityBox" Style="{StaticResource DarkComboBox}" SelectedIndex="1">
                    <ComboBoxItem Content="Any" />
                    <ComboBoxItem Content="$1,000" />
                    <ComboBoxItem Content="$10,000" />
                    <ComboBoxItem Content="$50,000" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="MAX POOL AGE" Style="{StaticResource CardLabel}" Margin="0,0,0,8" />
                <ComboBox x:Name="AgeBox" Style="{StaticResource DarkComboBox}" SelectedIndex="1">
                    <ComboBoxItem Content="Any" />
                    <ComboBoxItem Content="5 min" />
                    <ComboBoxItem Content="1 hour" />
                    <ComboBoxItem Content="24 hours" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="BUY AMOUNT (USDC)" Style="{StaticResource CardLabel}" Margin="0,0,0,8" />
                <TextBox x:Name="AmountBox" Style="{StaticResource TextInput}" Text="250" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="QUOTE TOKEN" Style="{StaticResource CardLabel}" Margin="0,0,0,8" />
                <ComboBox x:Name="QuoteBox" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="WETH" />
                    <ComboBoxItem Content="USDC" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="TAKE PROFIT, %" Style="{StaticResource CardLabel}" Margin="0,0,0,8" />
                <TextBox x:Name="TpBox" Style="{StaticResource TextInput}" Text="50" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="STOP LOSS, %" Style="{StaticResource CardLabel}" Margin="0,0,0,8" />
                <TextBox x:Name="SlBox" Style="{StaticResource TextInput}" Text="25" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <ToggleButton x:Name="EnabledToggle" Style="{StaticResource ToggleSwitch}" IsChecked="True" />
            <TextBlock Text="Rule active" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Click="OnCancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save rule" Margin="12,0,0,0" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
