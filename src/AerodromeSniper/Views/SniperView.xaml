<UserControl x:Class="AerodromeSniper.Views.SniperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AerodromeSniper.Models">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type models:RecentBuyRow}">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="12.5" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" Margin="12,0,0,0"
                           Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="28,22,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource TextInput}" Padding="34,9,12,9"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Path Data="{StaticResource IconSearch}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{StaticResource TextFaintBrush}" StrokeThickness="2"
                          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"
                          IsHitTestVisible="False" />
                </Grid>
                <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="150" Margin="12,0,0,0"
                          SelectedIndex="{Binding MinLiquidityIndex}">
                    <ComboBoxItem Content="Liquidity: any" />
                    <ComboBoxItem Content="≥ $1,000" />
                    <ComboBoxItem Content="≥ $10,000" />
                    <ComboBoxItem Content="≥ $50,000" />
                </ComboBox>
                <ComboBox Grid.Column="2" Style="{StaticResource DarkComboBox}" Width="130" Margin="12,0,0,0"
                          SelectedIndex="{Binding MaxAgeIndex}">
                    <ComboBoxItem Content="Age: any" />
                    <ComboBoxItem Content="&lt; 5 min" />
                    <ComboBoxItem Content="&lt; 1 hour" />
                    <ComboBoxItem Content="&lt; 24 hours" />
                </ComboBox>
                <ComboBox Grid.Column="3" Style="{StaticResource DarkComboBox}" Width="120" Margin="12,0,0,0"
                          SelectedIndex="{Binding QuoteIndex}">
                    <ComboBoxItem Content="Quote: all" />
                    <ComboBoxItem Content="WETH" />
                    <ComboBoxItem Content="USDC" />
                </ComboBox>
                <Button Grid.Column="5" Style="{StaticResource PrimaryButton}" Padding="20,0"
                        Command="{Binding ScanNowCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconZap}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Scan now" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Pools table -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,4,8,8" Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding Pools}" RowHeight="56">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="POOL" Width="2.2*" SortMemberPath="BaseSymbol">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Accent}">
                                        <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <Run Text="{Binding BaseSymbol, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding QuoteSymbol, Mode=OneWay}" />
                                            </TextBlock>
                                            <Border Style="{StaticResource BadgeBlue}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="NEW" Style="{StaticResource BadgeText}"
                                                           Foreground="{StaticResource PrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                            <TextBlock FontSize="10.5" FontFamily="Consolas"
                                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding Address, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DexTag, Mode=OneWay}" />
                                            </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="AGE" Width="76" Binding="{Binding AgeText}"
                                        SortMemberPath="AgeMinutes" />
                    <DataGridTextColumn Header="LIQUIDITY" Width="96" Binding="{Binding LiquidityText}"
                                        SortMemberPath="LiquidityUsd" />
                    <DataGridTextColumn Header="VOLUME 24H" Width="110" Binding="{Binding VolumeText}" />
                    <DataGridTextColumn Header="PRICE" Width="92" Binding="{Binding PriceText}" />
                    <DataGridTemplateColumn Header="24H" Width="80" SortMemberPath="ChangePct">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ChangePct, Converter={StaticResource PnlFormat}}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ChangePct, Converter={StaticResource PnlBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PrimaryButton}" Height="30" Padding="12,0"
                                        Content="Buy" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.SelectPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <!-- Quick buy -->
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="QUICK BUY" Style="{StaticResource CardLabel}" />

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding SelectedPool, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding SelectedPool.Accent}">
                                <TextBlock Text="{Binding SelectedPool.Initials}" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <Run Text="{Binding SelectedPool.BaseSymbol, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding SelectedPool.QuoteSymbol, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedPool.PriceText}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="AMOUNT (USDC)" Style="{StaticResource CardLabel}" Margin="0,16,0,8" />
                        <TextBox Style="{StaticResource TextInput}" Text="{Binding BuyAmountUsd, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="SLIPPAGE, %" Style="{StaticResource CardLabel}" Margin="0,12,0,8" />
                        <TextBox Style="{StaticResource TextInput}" Text="{Binding SlippagePct, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                Command="{Binding ConfirmBuyCommand}" Content="Buy now" />
                    </StackPanel>

                    <TextBlock Margin="0,14,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Visibility="{Binding SelectedPool, Converter={StaticResource NullToVisible}}"
                               Text="Pick a pool in the table to place a buy." />

                    <TextBlock Text="RECENT BUYS" Style="{StaticResource CardLabel}" Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding RecentBuys}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="No buys yet in this session."
                               Visibility="{Binding HasRecentBuys, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
